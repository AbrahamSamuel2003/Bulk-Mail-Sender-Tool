# =============================================================================
# AI-Powered Bulk Email Outreach & Follow-Up Management System
# Copy this file to .env and fill in the required secrets before starting.
# =============================================================================

# --- Application Security ---
APP_ENV=development
APP_ACCESS_PASSWORD=change-me-strong-password
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/outreach_db

# --- AI Integration (Groq / Gemini / OpenAI) ---
# Supported providers: groq (free tier), gemini (free tier), openai
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- Google OAuth 2.0 / Gmail API (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback

# --- SMTP / IMAP Sending Account ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Frontend ---
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://localhost:8000
